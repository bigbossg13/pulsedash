# Copy to .env.local for local development.

# FTC Events API proxy used by the pit display (see proxy/README.md).
# Leave empty to use FTCScout only.
NEXT_PUBLIC_FTC_EVENTS_PROXY=http://localhost:8787

# Override the FTCScout GraphQL endpoint (defaults to https://api.ftcscout.org/graphql).
# NEXT_PUBLIC_FTCSCOUT_URL=
